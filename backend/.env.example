# Copy to backend/.env and fill in. .env is gitignored.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set ONE of these, matching Settings -> API -> JWT in your Supabase project.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# Comma-separated. Add the deployed frontend origin before you deploy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Azure AI Foundry — the ONLY AI provider in this project (no OpenAI).
# Powers /api/receipts/scan (Person B). Endpoint is the full v1 Responses URL,
# e.g. https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
# Needs a vision-capable deployment (the receipt is sent as an image).
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=
