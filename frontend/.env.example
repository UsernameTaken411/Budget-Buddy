# Copy to .env.local and fill in. .env.local is gitignored.
#
# The frontend talks only to our own backend now, not Supabase directly —
# this is the only variable needed to boot the app. If a future feature adds
# a direct Supabase client back (see services/supabase.js), add
# VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY here at that point, not before.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional — only for demos/pitches. If both are set, Login shows a
# "Try the demo" button that signs straight into this account, no typing
# required. Use a throwaway account with no real financial data: these two
# values end up readable in the shipped frontend bundle, same as any other
# VITE_ variable. Leave unset to hide the button entirely.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
