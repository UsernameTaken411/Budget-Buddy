# Copy to .env.local and fill in. .env.local is gitignored.
#
# The frontend talks only to our own backend now, not Supabase directly —
# this is the only variable needed to boot the app. If a future feature adds
# a direct Supabase client back (see services/supabase.js), add
# VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY here at that point, not before.
VITE_API_BASE_URL=http://localhost:8000/api
